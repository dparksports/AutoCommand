<Window x:Class="AutoCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCommand.Views"
        Title="Auto-Command" Height="750" Width="1200"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <TabControl Grid.Row="0" Margin="0" Padding="0">
            <TabItem Header="⛨  Command Panel">
                <views:CommandPanelView x:Name="CommandPanelTab"/>
            </TabItem>
            <TabItem Header="🛡  Firewall">
                <views:FirewallSettingsView x:Name="FirewallTab"/>
            </TabItem>
            <TabItem Header="📋  Tasks">
                <views:TasksView x:Name="TasksTab"/>
            </TabItem>
            <TabItem Header="🔒  Privacy">
                <views:PrivacyView x:Name="PrivacyTab"/>
            </TabItem>
            <TabItem Header="⏻  Hibernation">
                <views:HibernationView x:Name="HibernationTab"/>
            </TabItem>
            <TabItem Header="🔐  DBX Safety">
                <views:DbxSafetyView x:Name="DbxTab"/>
            </TabItem>
            <TabItem Header="🌐  Connections">
                <views:ConnectionsView x:Name="ConnectionsTab"/>
            </TabItem>
            <TabItem Header="🚀  Startup">
                <views:StartupView x:Name="StartupTab"/>
            </TabItem>
            <TabItem Header="🛡️  OS Hardening">
                <views:HardeningView x:Name="HardeningTab"/>
            </TabItem>
            <TabItem Header="📡  Svchost Monitor">
                <views:SvchostMonitorView x:Name="SvchostTab"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Enforcer Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EnforcerDot" Width="8" Height="8" Fill="#4EC96F" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EnforcerStatusText" Text="Security Enforcer: Active" 
                               Foreground="#9D9DA5" FontSize="11"/>
                </StackPanel>

                <!-- Threat Alert -->
                <TextBlock x:Name="ThreatAlertText" Grid.Column="1" Text="" 
                           Foreground="#E5A631" FontSize="11" Margin="20,0" 
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Version -->
                <TextBlock Grid.Column="2" Text="AutoCommand v1.0" 
                           Foreground="#5A5A62" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

