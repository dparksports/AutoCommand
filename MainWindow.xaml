<Window x:Class="AutoCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCommand.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Auto-Command" Height="750" Width="1200"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hidden Telemetry Engine -->
        <wv2:WebView2 x:Name="HiddenTelemetryWebView" Width="1" Height="1" Visibility="Hidden" IsHitTestVisible="False" />

        <!-- Main Content -->
        <TabControl x:Name="MainTabControl" Grid.Row="0" TabStripPlacement="Left"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Fresh Setup" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:FreshSetupView x:Name="FreshSetupTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🧭" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Sysmon Audit" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SysmonStatusView x:Name="SysmonTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Process Monitor" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SvchostMonitorView x:Name="SvchostTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🌐" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Connections" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:ConnectionsView x:Name="ConnectionsTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="📡" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Attack Surface" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:CommandPanelView x:Name="CommandPanelTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🛡" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Firewall" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:FirewallSettingsView x:Name="FirewallTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🔒" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="OS Hardening" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:HardeningView x:Name="HardeningTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="DBX Safety" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:DbxSafetyView x:Name="DbxTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="👁" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Privacy" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:PrivacyView x:Name="PrivacyTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Telemetry" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TelemetryView x:Name="TelemetryTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="❄" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Update Control" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:UpdateControlView x:Name="UpdateControlTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Default Apps" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:DefaultAppsView x:Name="DefaultAppsTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Tasks" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TasksView x:Name="TasksTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🚀" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Startup" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:StartupView x:Name="StartupTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="🌙" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Hibernation" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:HibernationView x:Name="HibernationTab"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Width="160" Margin="0,10">
                        <TextBlock Text="⚙" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Settings" HorizontalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>

        <!-- AI Insight Panel: shown automatically after tab switch -->
        <Border x:Name="AiInsightPanel" Grid.Row="1"
                Background="#080E1C" BorderBrush="#1E3A5F" BorderThickness="0,1,0,0"
                Padding="14,5" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- dot -->
                    <ColumnDefinition Width="Auto"/>  <!-- "AI:" label -->
                    <ColumnDefinition Width="*"/>     <!-- summary text -->
                    <ColumnDefinition Width="Auto"/>  <!-- 🚀 Start Engine (server-down state) -->
                    <ColumnDefinition Width="Auto"/>  <!-- See full report (result state) -->
                    <ColumnDefinition Width="Auto"/>  <!-- ✕ dismiss -->
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="AiInsightDot" Grid.Column="0"
                         Width="7" Height="7" Fill="#475569"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Grid.Column="1" Text="AI:" Foreground="#4ADE80"
                           FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="AiInsightText" Grid.Column="2"
                           Foreground="#94A3B8" FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="Analyzing…"/>

                <!-- Shown when local server is offline -->
                <Button x:Name="AiInsightStartBtn" Grid.Column="3"
                        Content="🚀 Start Engine"
                        Background="#92400E" Foreground="#FDE68A"
                        BorderThickness="0" FontSize="10"
                        Padding="10,2" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="AiInsightStartBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style>
                    </Button.Resources>
                </Button>

                <!-- Shown when a result is cached -->
                <Button x:Name="AiInsightDetailBtn" Grid.Column="4"
                        Content="See full report →"
                        Background="Transparent" Foreground="#60A5FA"
                        BorderThickness="0" FontSize="10"
                        Padding="10,0" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="AiInsightDetailBtn_Click"/>

                <Button Grid.Column="5" Content="✕"
                        Background="Transparent" Foreground="#334155"
                        BorderThickness="0" FontSize="9"
                        Padding="6,0" Cursor="Hand"
                        Click="AiInsightDismissBtn_Click"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#0B101E" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Enforcer Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EnforcerDot" Width="8" Height="8" Fill="#00E5FF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EnforcerStatusText" Text="Security Enforcer: Active" 
                               Foreground="#9D9DA5" FontSize="11"/>
                </StackPanel>

                <!-- Threat Alert & AI Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Button x:Name="AiAuditBtn" Content="✨ AI Security Audit" 
                            Background="#1E293B" Foreground="#4ADE80" BorderBrush="#334155" BorderThickness="1" 
                            Padding="8,2" FontSize="11" Margin="0,0,5,0" Cursor="Hand" Click="AiAuditBtn_Click"/>
                    <Button x:Name="AiSettingsBtn" Content="⚙️" 
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0" 
                            Padding="4,2" FontSize="11" Margin="0,0,15,0" Cursor="Hand" Click="AiSettingsBtn_Click"/>
                            
                    <TextBlock x:Name="ThreatAlertText" Text="" 
                               Foreground="#E5A631" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="ReviewAlertBtn" Content="Review" 
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="ReviewAlertBtn_Click"/>
                </StackPanel>

                <!-- Version -->
                <TextBlock x:Name="VersionText" Grid.Column="2" Text="AutoCommand"
                           Foreground="#5A5A62" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

