<UserControl x:Class="AutoCommand.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Plugins &amp; Extensions" Style="{StaticResource PageHeader}"/>
                <Button Content="↻ Reload Plugins" Margin="20,0,0,0" 
                        Style="{StaticResource PrimaryButton}" Click="ReloadBtn_Click"/>
                <Button Content="📂 Open Plugins Folder" Margin="10,0,0,0" 
                        Click="OpenFolderBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Plugins List -->
        <DataGrid x:Name="PluginsDataGrid" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="60"/>
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                <DataGridTemplateColumn Header="Action" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Run" Style="{StaticResource PrimaryButton}" 
                                    Padding="8,2" FontSize="10" Click="RunPluginBtn_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Compile Errors -->
        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardPanel}" Padding="12" 
                x:Name="CompileErrorsPanel" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Source Compilation Errors" FontWeight="SemiBold" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,0,4"/>
                <ItemsControl x:Name="ErrorsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- SDK Info -->
        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource CardPanel}" Padding="12">
            <StackPanel>
                <TextBlock Text="Extensibility SDK" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="You can drop pre-compiled .dll files OR raw C# .cs files into the 'Plugins' folder." 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="The app uses Roslyn to dynamically compile and load your source code at runtime." 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
