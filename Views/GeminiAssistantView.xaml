<UserControl x:Class="AutoCommand.Views.GeminiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="AI Command Assistant" Style="{StaticResource PageHeader}"/>
                    <Button Content="🗑 Clear Chat" Margin="20,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="AiClearChatBtn_Click"/>
                </StackPanel>
                <TextBlock Text="Ask Gemini (or the local model) to generate a command for any task — review it, then run it."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Assistant Body -->
        <GroupBox Grid.Row="1" Header="✨ Gemini Command Assistant" Padding="8"
                  ToolTip="Ask Gemini to generate and run PowerShell commands to manage your system.">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tell Gemini what you want to do (e.g., 'Disable the Windows Search service' or 'List all scheduled tasks in a folder'). It will generate the script for you to review."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="4,0,4,10"/>

                <TextBox Grid.Row="1" x:Name="AiChatLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="8" FontFamily="Consolas" FontSize="12"/>

                <!-- Loading / Run State -->
                <StackPanel Grid.Row="2" x:Name="AiReviewPanel" Visibility="Collapsed" Margin="4,10,4,0">
                    <TextBlock Text="Suggested Command:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="AiSuggestedCommand" Background="#1E293B" Foreground="#4ADE80" FontFamily="Consolas"
                             BorderThickness="1" BorderBrush="#334155" Padding="6" IsReadOnly="True" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="AiCancelCommandBtn_Click"/>
                        <Button Content="Run Command" Style="{StaticResource PrimaryButton}" Click="AiRunCommandBtn_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Input Box -->
                <Grid Grid.Row="3" Margin="4,10,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AiPromptInput" Grid.Column="0" Padding="6"
                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             KeyUp="AiPromptInput_KeyUp"
                             ToolTip="Type your request here and press Enter."/>
                    <Button x:Name="AiSendBtn" Grid.Column="1" Content="Ask" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="AiSendBtn_Click"/>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
