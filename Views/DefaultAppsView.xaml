<UserControl x:Class="AutoCommand.Views.DefaultAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AutoCommand.Converters"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <conv:BloatwareStateConverter x:Key="BloatwareStateConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bloatware" Style="{StaticResource PageHeader}"/>
                    <Button Content="↻ Refresh List" Margin="20,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
                    <Button x:Name="RemoveBloatwareBtn" Content="🧹 Remove Bloatware" Margin="12,0,0,0"
                            Style="{StaticResource DangerButton}" Click="RemoveBloatwareBtn_Click"
                            ToolTip="Uninstall Outlook, Xbox, Phone Link, Teams, Copilot, OneDrive and other preinstalled apps after confirmation."/>
                    <Button x:Name="ManageBloatwareBtn" Content="⚙ Manage List" Margin="12,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="ManageBloatwareBtn_Click"
                            ToolTip="Customize which apps count as bloatware: enable/disable defaults, add your own."/>
                </StackPanel>
                <TextBlock Text="The Store-packaged apps Windows Settings shows under Apps → Installed apps — apps you can uninstall (Outlook, Teams, Copilot, …). Win32 desktop apps such as OneDrive are only targeted by Remove Bloatware."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- View Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="SystemComponentsCheck" Content="Include system components (OS-signed)"
                      Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                      Checked="FilterChanged" Unchecked="FilterChanged"/>
            <TextBlock x:Name="AppCountText" Text="" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="20,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <!-- Apps List -->
        <DataGrid x:Name="AppsDataGrid" Grid.Row="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="App Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*"/>
                <DataGridTextColumn Header="Signature Status" Binding="{Binding SignatureStatus}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="Valid (Store)">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                </Trigger>
                                <Trigger Property="Text" Value="Valid (Enterprise)">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                </Trigger>
                                <Trigger Property="Text" Value="System component">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Trigger>
                                <Trigger Property="Text" Value="Developer-signed">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentAmberBrush}"/>
                                </Trigger>
                                <Trigger Property="Text" Value="Unsigned">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
                                </Trigger>
                                <Trigger Property="Text" Value="Invalid/Error">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Signer / Publisher" Binding="{Binding SignerCertificate}" Width="2*"/>
                <!-- One-click list membership: add exact package / disable the
                     matching default pattern. Collapses on non-toggleable rows. -->
                <DataGridTemplateColumn Header="Bloatware" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Converter={StaticResource BloatwareStateConverter}}"
                                    ToolTip="{Binding Converter={StaticResource BloatwareStateConverter}, ConverterParameter=tooltip}"
                                    Click="BloatwareToggle_Click" Padding="8,2" FontSize="10">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Action" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Uninstall" Style="{StaticResource DangerButton}"
                                    Padding="8,2" FontSize="10" Click="UninstallBtn_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer Info -->
        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource CardPanel}" Padding="12">
            <TextBlock Text="Note: Removing system-critical apps may cause instability. Use with caution. Signature status reflects the package's deployment-validated signature kind (Store / Enterprise signatures are valid); the signer is taken from the package publisher."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
