<UserControl x:Class="AutoCommand.Views.HardeningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OS Hardening" Style="{StaticResource PageHeader}"/>
                <Button Content="↻ Refresh" Margin="20,0,0,0" 
                        Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- LSA Protection -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Local Security Authority (LSA) Protection" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="RunAsPPL protects LSASS.exe from memory dumping tools like Mimikatz." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="LsaStatusText" Text="Checking..." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Disable" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}" Click="LsaDisableBtn_Click"/>
                            <Button Content="Enable"
                                    Style="{StaticResource PrimaryButton}" Click="LsaEnableBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- UAC Strictness -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="UAC Maximum Strictness" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Requires explicit consent for all administrative actions (ConsentPromptBehaviorAdmin=2)." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="UacStatusText" Text="Checking..." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Relax UAC" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}" Click="UacRelaxBtn_Click"/>
                            <Button Content="Max Strictness"
                                    Style="{StaticResource PrimaryButton}" Click="UacStrictBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hosts File Monitor -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Hosts File Integrity" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="C:\Windows\System32\drivers\etc\hosts — often modified by malware for silent redirects." 
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock x:Name="HostsStatusText" Text="Checking..." 
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset to Default" VerticalAlignment="Top"
                                    Style="{StaticResource DangerButton}" Click="HostsResetBtn_Click"/>
                        </Grid>
                        
                        <TextBox Grid.Row="1" x:Name="HostsContentBox" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                 MaxHeight="200" VerticalScrollBarVisibility="Auto" Padding="8"/>
                    </Grid>
                </Border>

                <!-- Disable IPv6 -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Disable IPv6 System-Wide" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Disables IPv6 on all network adapters to reduce attack surface (requires reboot)." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="Ipv6StatusText" Text="Checking..." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Enable IPv6" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}" Click="Ipv6EnableBtn_Click"/>
                            <Button Content="Disable IPv6"
                                    Style="{StaticResource PrimaryButton}" Click="Ipv6DisableBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
