<UserControl x:Class="AutoCommand.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoCommand.Converters"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <converters:TaskStateToColorConverter x:Key="StateColor"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Scheduled Tasks" Style="{StaticResource PageHeader}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="AllRadio" Content="All" 
                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <RadioButton x:Name="RunningRadio" Content="Running" IsChecked="True"
                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <RadioButton x:Name="ReadyRadio" Content="Ready" 
                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <RadioButton x:Name="DisabledRadio" Content="Disabled" 
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Checked="FilterChanged"/>
            <TextBlock x:Name="TaskCountText" Text="" Foreground="{StaticResource TextSecondaryBrush}" 
                       Margin="20,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <!-- Tasks Grid -->
        <DataGrid Grid.Row="2" x:Name="TasksGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding TaskName}" Width="*"/>
                <DataGridTextColumn Header="Path" Binding="{Binding TaskPath}" Width="200"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding State, Converter={StaticResource StateColor}}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200"/>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="120"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Disable Task" Click="DisableTask_Click"/>
                    <MenuItem Header="Enable Task" Click="EnableTask_Click"/>
                    <Separator/>
                    <MenuItem Header="Run Task" Click="RunTask_Click"/>
                    <MenuItem Header="Stop Task" Click="StopTask_Click"/>
                    <Separator/>
                    <MenuItem Header="Delete Task" Click="DeleteTask_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>

