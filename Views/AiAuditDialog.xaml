<Window x:Class="AutoCommand.Views.AiAuditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Security Audit" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="#E2E8F0"
        WindowStyle="ToolWindow" FontFamily="Segoe UI" Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading State -->
        <StackPanel x:Name="LoadingPanel" Grid.RowSpan="4" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
            <TextBlock Text="✨" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:1" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
            <TextBlock Text="Analyzing security data..." FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Results State (Hidden initially) -->
        <Grid x:Name="ResultsPanel" Grid.RowSpan="4" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Threat Level Header -->
            <Border x:Name="ThreatBorder" CornerRadius="8" Padding="15" Margin="0,0,0,20" Background="#1E293B">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ThreatIcon" Text="🟢" FontSize="36" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Threat Level:" FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock x:Name="ThreatLevelText" Text="Safe" FontSize="24" FontWeight="Bold" Foreground="#4ADE80"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Summary -->
            <TextBlock Grid.Row="1" Text="Summary" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#E2E8F0"/>
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="15" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,15" Foreground="#F8FAFC"/>
                        <TextBlock Text="Detailed Analysis:" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DetailsText" TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartLocalEngineBtn" Content="🚀 Start Local AI Engine" Width="160" Padding="8,6" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Visibility="Collapsed" Click="StartLocalEngineBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Close" Width="100" Padding="8,6" Background="#334155" Foreground="White" BorderThickness="0" Click="CloseBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
