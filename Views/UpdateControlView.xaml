<UserControl x:Class="AutoCommand.Views.UpdateControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="980">

            <TextBlock Text="Update Control" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Some apps silently replace themselves in place (rename the old exe to .old, write a new one). Freezing an app adds an NTFS deny rule for delete/write on its exe: the app keeps running normally, but its updater fails until you unfreeze it. The original permissions are snapshotted first, so unfreezing restores exactly what was there."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Self-updating apps" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        <Button x:Name="DiscoverBtn" Grid.Column="1" Content="Discover" Style="{StaticResource PrimaryButton}"
                                Padding="12,4" Click="DiscoverBtn_Click"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="Press Discover to scan for self-updating apps (self-update .old leftovers, updater folders, autostart updaters)."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DataGrid x:Name="TargetsGrid" MinHeight="140" MaxHeight="380" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="App" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding ExePath}" Width="230">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding ExePath}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Discovered because" Binding="{Binding Evidence}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Evidence}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Vendor}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="FreezeBtn" Content="❄ Freeze selected" Style="{StaticResource PrimaryButton}"
                                Padding="12,5" Margin="0,0,8,0" Click="FreezeBtn_Click"/>
                        <Button x:Name="ThawBtn" Content="Unfreeze selected" Padding="12,5" Click="ThawBtn_Click"
                                ToolTip="Restores the original permissions and re-allows updates."/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
