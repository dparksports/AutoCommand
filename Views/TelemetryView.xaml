<UserControl x:Class="AutoCommand.Views.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="980">

            <TextBlock Text="Telemetry Opt-Out" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Many installed apps and libraries phone home usage statistics by default. This tab knows the official opt-out switch for each one, shows whether it is currently on, and applies or reverts the setting with the previous value snapshotted — nothing here is a one-way door."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Detected software" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        <Button x:Name="ScanBtn" Grid.Column="1" Content="Rescan" Style="{StaticResource PrimaryButton}"
                                Padding="12,4" Click="ScanBtn_Click"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="Scanning…"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DataGrid x:Name="RulesGrid" MinHeight="160" MaxHeight="400" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="App" Binding="{Binding AppName}" Width="170"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StateText}" Width="90"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="ToolTip" Value="{Binding Evidence}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="OptOutBtn" Content="Opt out selected" Style="{StaticResource PrimaryButton}"
                                Padding="12,5" Margin="0,0,8,0" Click="OptOutBtn_Click"/>
                        <Button x:Name="RevertBtn" Content="Revert selected" Padding="12,5" Margin="0,0,8,0" Click="RevertBtn_Click"
                                ToolTip="Restores the setting that was in place before the opt-out."/>
                        <Button x:Name="VerifyBtn" Content="Verify: still beaconing?" Padding="12,5" Click="VerifyBtn_Click"
                                ToolTip="Checks the DNS resolver cache for the telemetry domains this app is known to contact."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="How this works" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Each entry applies the vendor's own documented opt-out (a settings key, environment variable or policy), not a firewall block. Changes are snapshotted to telemetry_state.json before they are made, so Revert puts back exactly what was there."/>
                    </TextBlock>
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
