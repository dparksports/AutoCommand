<Window x:Class="AutoCommand.Views.BlockedRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocked Rules — manage all AutoCommand firewall blocks" Width="980" Height="640" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Blocked Rules" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Every block AutoCommand created — grouped by destination owner. Red groups are Microsoft infrastructure or Windows components: blocking them usually breaks updates, notifications or DNS, not threats."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,-8,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="RefreshBtn_Click" Margin="0,0,8,0"/>
            <Button Content="✕ Unblock selected" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="UnblockSelectedBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="UnblockMsBtn" Content="✕ Unblock Microsoft-owned ⚠" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="UnblockMsBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="ConsolidateBtn" Content="🧹 Consolidate legacy (4→2 rules)" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="ConsolidateBtn_Click" Margin="0,0,8,0"/>
            <Button Content="⬇ Export CSV" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="ExportBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="ReenableBtn" Content="↩ Re-enable all (undo panic)" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="ReenableBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="RestoreExceptRiskyBtn" Content="↩ Restore except Microsoft/Windows ⚠" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="RestoreExceptRiskyBtn_Click" Margin="0,0,8,0"
                    ToolTip="Re-enables every block EXCEPT Microsoft/CDN and Windows-component targets — the ones that break internet, updates or notifications. Those stay disabled (red rows) until you decide."/>
            <Button x:Name="EnableLogBtn" Content="📋 Enable drop-logging (shows hit counts)" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="EnableLogBtn_Click" Margin="0,0,8,0"
                    ToolTip="Turns on 'Log dropped packets' for all firewall profiles (4 MB cap, default file). The Hits column then shows how often each block actually fires."/>
            <Button x:Name="RdapBtn" Content="🌐 RDAP-verify unclassified" Style="{StaticResource PrimaryButton}" Padding="10,2" Click="RdapBtn_Click" Margin="0,0,8,0"
                    ToolTip="Asks the registries who owns each unclassified target. Results are cached machine-wide (C:\ProgramData\AutoCommand\rdap-cache.json) — repeat runs are instant and offline-capable."/>
        </WrapPanel>

        <DataGrid Grid.Row="2" x:Name="RulesGrid" SelectionMode="Extended" IsReadOnly="True"
                  FontFamily="Consolas" FontSize="11" AutoGenerateColumns="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRisky}" Value="True">
                            <Setter Property="Background" Value="#2A0F18"/>
                            <Setter Property="Foreground" Value="#F2A0B4"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Target"    Binding="{Binding Target}"   Width="170"/>
                <DataGridTextColumn Header="Kind"      Binding="{Binding Kind}"     Width="46"/>
                <DataGridTextColumn Header="Owner / class" Binding="{Binding Class}" Width="150"/>
                <DataGridTextColumn Header="Rules"     Binding="{Binding RulesSummary}" Width="90"/>
                <DataGridTextColumn Header="Blocked"   Binding="{Binding CreatedDisplay}" Width="120"/>
                <DataGridTextColumn Header="Hits 10m"  Binding="{Binding HitsDisplay}"   Width="70"/>
                <DataGridTextColumn Header="RDAP owner" Binding="{Binding OwnerDisplay}" Width="170"/>
                <DataGridTextColumn Header="Provenance (also in wf.msc → rule Properties)" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Loading…"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
