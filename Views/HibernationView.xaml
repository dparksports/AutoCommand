<UserControl x:Class="AutoCommand.Views.HibernationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hibernation &amp; Shutdown" Style="{StaticResource PageHeader}"/>

        <StackPanel Grid.Row="1" MaxWidth="600" HorizontalAlignment="Left">

            <!-- Hibernate Status -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Hibernation" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Hibernate writes RAM to disk — creates hiberfile that can be forensically analyzed."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,12"/>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                        <TextBlock x:Name="HibernateStatusText" Text="Checking..." FontSize="12"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DisableHibernateBtn" Content="Disable Hibernate" Margin="0,0,8,0"
                                Style="{StaticResource DangerButton}" Click="DisableHibernateBtn_Click"/>
                        <Button x:Name="EnableHibernateBtn" Content="Enable Hibernate"
                                Style="{StaticResource PrimaryButton}" Click="EnableHibernateBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Power States -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Available Power States" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="12,8">
                        <TextBlock x:Name="PowerStatesText" Text="Loading..." FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- True Shutdown -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="True Shutdown" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Performs a full shutdown (not hybrid). Clears RAM and all session state."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,12"/>
                    <Button Content="⏻  True Shutdown Now" Style="{StaticResource DangerButton}"
                            Click="TrueShutdownBtn_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>

