<UserControl x:Class="AutoCommand.Views.DbxSafetyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="DBX / EFI Safety Check" Style="{StaticResource PageHeader}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RunCheckBtn" Content="▶ Run Full Check" 
                        Style="{StaticResource PrimaryButton}" Click="RunCheckBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="RepairBootBtn" Content="Repair Boot"
                        Style="{StaticResource DangerButton}" Click="RepairBootBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Results -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- EFI Partition -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="EFI PARTITION" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="EfiStatusText" Text="Not checked" 
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Baseline -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="INTEGRITY BASELINE" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="BaselineStatusText" Text="Not checked" 
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Sigcheck -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="AUTHENTICODE VERIFICATION" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="SigcheckStatusText" Text="Not checked" 
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- DBX Revocation -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DBX REVOCATION CHECK" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="DbxStatusText" Text="Not checked" 
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- DBX Update -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DBX UPDATE" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="DbxUpdateStatusText" Text="Download the latest DBX update from Microsoft"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="DownloadDbxBtn" Content="Download" Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButton}" Click="DownloadDbxBtn_Click"/>
                            <Button x:Name="InstallDbxBtn" Content="Install" IsEnabled="False"
                                    Style="{StaticResource DangerButton}" Click="InstallDbxBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Output -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="DETAILED LOG" Style="{StaticResource SectionHeader}"/>
                        <TextBox x:Name="LogOutput" IsReadOnly="True" TextWrapping="Wrap"
                                 Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                 MaxHeight="300" VerticalScrollBarVisibility="Auto" Padding="8"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

