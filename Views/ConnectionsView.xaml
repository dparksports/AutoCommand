<UserControl x:Class="AutoCommand.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoCommand.Converters"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:GroupSizeExpanderConverter x:Key="GroupSizeExpander"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Active Network Connections" Style="{StaticResource PageHeader}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="AllRadio" Content="All" IsChecked="True" 
                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <RadioButton x:Name="TcpRadio" Content="TCP Only" 
                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <RadioButton x:Name="UdpRadio" Content="UDP Only" 
                         Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <CheckBox x:Name="LiveViewCheck" Content="Live View (2s)" 
                      Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"
                      Checked="LiveViewChanged" Unchecked="LiveViewChanged"/>
            <TextBlock x:Name="ConnectionCountText" Text="" Foreground="{StaticResource TextSecondaryBrush}" 
                       Margin="20,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <!-- Connections Grid -->
        <DataGrid Grid.Row="2" x:Name="ConnectionsGrid" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="{Binding Converter={StaticResource GroupSizeExpander}, Mode=OneWay}"
                                                  Background="{StaticResource SurfaceAltBrush}"
                                                  BorderBrush="{StaticResource BorderBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{StaticResource TextPrimaryBrush}">
                                            <Expander.Header>
                                                <TextBlock FontWeight="SemiBold" FontSize="12" Padding="4"
                                                           Text="{Binding Name, StringFormat='{} {0}'}"/>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                <DataGridTextColumn Header="Local Address" Binding="{Binding LocalAddress}" Width="160"/>
                <DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteAddress}" Width="160"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80"/>
                <DataGridTextColumn Header="Process Name" Binding="{Binding ProcessName}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Kill Process" Click="KillProcess_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
