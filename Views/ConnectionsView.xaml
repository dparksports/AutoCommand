<UserControl x:Class="AutoCommand.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoCommand.Converters"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:GroupSizeExpanderConverter x:Key="GroupSizeExpander"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Active Network Connections" Style="{StaticResource PageHeader}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Source:" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SourceCombo" Width="140" Margin="0,0,16,0" SelectionChanged="SourceChanged">
                <ComboBoxItem Content="Polling (Live)" IsSelected="True"/>
                <ComboBoxItem Content="Sysmon (Events)"/>
                <ComboBoxItem Content="Raw Socket (Packets)"/>
            </ComboBox>

            <RadioButton x:Name="AllRadio" Content="All" IsChecked="True" 
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <RadioButton x:Name="TcpRadio" Content="TCP Only" 
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <RadioButton x:Name="UdpRadio" Content="UDP Only" 
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <CheckBox x:Name="LiveViewCheck" Content="Auto-Refresh" 
                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"
                      Checked="LiveViewChanged" Unchecked="LiveViewChanged"/>
            <TextBlock x:Name="ConnectionCountText" Text="" Foreground="{DynamicResource TextSecondaryBrush}" 
                       Margin="20,0,0,0" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <!-- Connections Grid -->
        <DataGrid Grid.Row="2" x:Name="ConnectionsGrid" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="{Binding Converter={StaticResource GroupSizeExpander}, Mode=OneWay}"
                                                  Background="{DynamicResource SurfaceAltBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Expander.Header>
                                                <TextBlock FontWeight="SemiBold" FontSize="12" Padding="4"
                                                           Text="{Binding Name, StringFormat='{} {0}'}"/>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                <DataGridTextColumn Header="Local Address" Binding="{Binding LocalAddress}" Width="160"/>
                <DataGridTextColumn Header="Remote IP" Binding="{Binding RemoteAddress}" Width="120"/>
                <DataGridTemplateColumn Header="Remote Host" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RemoteHost}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="FontStyle"  Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                <Setter Property="FontStyle"  Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80"/>
                <DataGridTextColumn Header="Process Name" Binding="{Binding ProcessName}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Block Remote IP in Firewall" Click="BlockRemoteIP_Click"/>
                    <MenuItem Header="Block All Remote IPs of Process" Click="BlockAllRemoteIPs_Click"/>
                    <MenuItem Header="Block Process in Firewall" Click="BlockProcess_Click"/>
                    <MenuItem Header="Kill Process" Click="KillProcess_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
