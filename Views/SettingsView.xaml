<UserControl x:Class="AutoCommand.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="Configure Auto-Command preferences and startup behavior." 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Application Information -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Application Information" Style="{StaticResource SectionHeader}"/>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Version:" Foreground="{StaticResource TextSecondaryBrush}" Width="150" VerticalAlignment="Center"/>
                            <TextBlock Text="3.2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="Developed by:" Foreground="{StaticResource TextSecondaryBrush}" Width="150" VerticalAlignment="Center"/>
                            <TextBlock Text="Auto-Command Security Tools" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Startup Behavior -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Startup Behavior" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <CheckBox x:Name="LaunchOnStartupCheck" 
                                      Content="Launch when user logs in" 
                                      Checked="LaunchOnStartupCheck_Checked"
                                      Unchecked="LaunchOnStartupCheck_Unchecked"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Row="2" Text="This creates a Scheduled Task to run Auto-Command with highest privileges upon user login, bypassing the UAC prompt."
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>