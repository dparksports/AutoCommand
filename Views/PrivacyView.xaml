<UserControl x:Class="AutoCommand.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Privacy &amp; Tracking" Style="{StaticResource PageHeader}"/>
                <Button Content="↻ Refresh" Margin="20,0,0,0" 
                        Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Privacy Toggles -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- VPN Services -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="VPN Services" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="RasMan, IKEEXT, PolicyAgent, RemoteAccess" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="VpnStatusText" Text="Checking..." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="VpnDisableBtn" Content="Disable All" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}" Click="VpnDisableBtn_Click"/>
                            <Button x:Name="VpnEnableBtn" Content="Enable All"
                                    Style="{StaticResource PrimaryButton}" Click="VpnEnableBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WiFi Direct -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WiFi Direct Virtual Adapter" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Microsoft Virtual WiFi adapter — can create hidden hotspots" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="WifiDirectStatusText" Text="Checking..." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Disable" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}" Click="WifiDirectDisableBtn_Click"/>
                            <Button Content="Enable"
                                    Style="{StaticResource PrimaryButton}" Click="WifiDirectEnableBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Kernel Debug -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kernel Debug Network" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="KDNET — kernel-level remote debugger access" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="KdnetStatusText" Text="Checking..." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Disable" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}" Click="KdnetDisableBtn_Click"/>
                            <Button Content="Enable"
                                    Style="{StaticResource PrimaryButton}" Click="KdnetEnableBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Usage Data / Telemetry -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Usage Data &amp; Telemetry" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="UsageDataReceiver scheduled task — sends telemetry to Microsoft" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="UsageDataStatusText" Text="Checking..." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Disable" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}" Click="UsageDataDisableBtn_Click"/>
                            <Button Content="Enable"
                                    Style="{StaticResource PrimaryButton}" Click="UsageDataEnableBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tamper Protection -->
                <Border Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Defender Tamper Protection" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Prevents unauthorized changes to Windows Defender settings" 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TamperStatusText" Text="Checking..." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TamperIcon" Grid.Column="1" FontSize="24" VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

