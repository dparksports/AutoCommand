<Window x:Class="AutoCommand.Views.BloatwareListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Bloatware List" Width="720" Height="660" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10"
                   Text="Changes apply immediately and are saved to C:\ProgramData\AutoCommand\bloatware_config.json (machine-wide). Defaults shipped in future app updates stay in force unless disabled here."/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Default list -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Default bloatware list" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DefaultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}"
                                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,3"
                                              Checked="DefaultCheck_Changed" Unchecked="DefaultCheck_Changed"
                                              ToolTip="{Binding Pattern}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Custom entries -->
            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="10" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Custom apps (exact package names)" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Grid.Row="1" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewPackageBox" Padding="4"
                                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="11"
                                     KeyDown="NewPackageBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="12,2"
                                    Style="{StaticResource PrimaryButton}" Click="AddCustomPackageBtn_Click"/>
                        </Grid>
                        <ListBox x:Name="CustomPackagesList" Grid.Row="2" MinHeight="60"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button Content="✕" DockPanel.Dock="Right" FontSize="10" Padding="6,0" Margin="6,0,0,0"
                                                Style="{StaticResource DangerButton}" Click="RemoveCustomPackageBtn_Click"/>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Custom patterns (advanced — substring match)" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                        <TextBlock Grid.Row="1" Text="A pattern matches any package whose name or display name contains it. Prefer exact apps; use Preview below to check what a pattern would catch."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,6"/>
                        <Grid Grid.Row="2" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewPatternBox" Padding="4"
                                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="11"
                                     KeyDown="NewPatternBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="12,2"
                                    Style="{StaticResource PrimaryButton}" Click="AddCustomPatternBtn_Click"/>
                        </Grid>
                        <ListBox x:Name="CustomPatternsList" Grid.Row="3" MinHeight="40"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="11">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button Content="✕" DockPanel.Dock="Right" FontSize="10" Padding="6,0" Margin="6,0,0,0"
                                                Style="{StaticResource DangerButton}" Click="RemoveCustomPatternBtn_Click"/>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Preview -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PreviewBtn" Content="🔍 Preview matches" Padding="12,2"
                            Style="{StaticResource PrimaryButton}" Click="PreviewBtn_Click"/>
                    <TextBlock x:Name="PreviewCountText" Text="See exactly what the current list would remove."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="PreviewList" Grid.Row="1" Height="110" Margin="0,8,0,0"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" FontFamily="Consolas" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="↺ Reset to defaults" Style="{StaticResource DangerButton}" Click="ResetBtn_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Style="{StaticResource PrimaryButton}" Click="CloseBtn_Click" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
